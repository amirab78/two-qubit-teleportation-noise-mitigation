title: "Two-qubit teleportation through a noisy channel, corrected from measurement counts: code and data"
version: 1.0.0
date-released: "2026-10-25"
doi: "[DOI]"
license: MIT
repository-code: "https://github.com/amirab78/teleportation-counts-correction"
type: software
authors:
  - family-names: "Abdolhosseini"
    given-names: "Amir H."
